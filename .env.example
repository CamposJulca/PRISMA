# ============================================================================
# PRISMA-GTI — Variables de entorno
# ============================================================================
# Copiar este archivo a .env y completar con los valores reales.
# El archivo .env NUNCA debe versionarse en Git (está en .gitignore).
# Permisos recomendados en el servidor: chmod 600 .env
# ============================================================================

# ---------- Bases de datos SQL Server ----------
ARANDA_DB_DRIVER=ODBC Driver 17 for SQL Server
ARANDA_DB_SERVER=172.16.20.70
ARANDA_DB_NAME=ArandaDB8
ARANDA_DB_USER=
ARANDA_DB_PASSWORD=

DISCOVERY_DB_DRIVER=ODBC Driver 17 for SQL Server
DISCOVERY_DB_SERVER=172.16.20.70
DISCOVERY_DB_NAME=DiscovSQL
DISCOVERY_DB_USER=
DISCOVERY_DB_PASSWORD=

KACTUS_DB_DRIVER=ODBC Driver 17 for SQL Server
KACTUS_DB_SERVER=172.16.20.70
KACTUS_DB_NAME=kactus
KACTUS_DB_USER=
KACTUS_DB_PASSWORD=

# Timeouts en segundos
DB_CONNECTION_TIMEOUT=30
DB_QUERY_TIMEOUT=300

# ---------- LDAP / Active Directory ----------
LDAP_SERVER=ldap://172.16.0.5:389
LDAP_BASE_DN=dc=FINAGRO,dc=LOC
LDAP_USER=FINAGRO\\entrustuser
LDAP_PASSWORD=
LDAP_BATCH_SIZE=200
LDAP_TIMEOUT=10

# ---------- URLs externas ----------
INDICADORES_PERIODO_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTAAMciXbcVHx7wnAXNBbgj-gqZDHFR1ekdEoTYsLSrliR1haoqFIE47DFb2RiwTQ/pub?output=xlsx
INDICADORES_PERIODO_2026_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRsg_vDdz2buakTCpAsRfQhnrJx6XzJ0tltavcR4wGvHBsJOhR0DwmIV_dd_Ryz8g/pub?output=xlsx

# ---------- Rutas locales ----------
# Pueden sobrescribir las rutas por defecto definidas en config/settings.yaml
DATA_RAW_DIR=./data/raw
DATA_INTERIM_DIR=./data/interim
DATA_OUTPUT_DIR=./data/output

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FILE=./logs/prisma.log

# ---------- Modo de ejecución ----------
# DEBUG=true conserva archivos intermedios y aumenta verbosidad
DEBUG=false
