# ============================================================================
# PRISMA-GTI — .gitignore
# ============================================================================

# ---------- Credenciales y configuración local ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- Datos ----------
# Los datos NUNCA van al repo (contienen información personal y son grandes)
data/raw/*
data/interim/*
data/output/*
data/reference/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/output/.gitkeep
!data/reference/.gitkeep

# Notebooks legacy (referencia local mientras se hace el refactor)
legacy/
*.ipynb_checkpoints/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Entornos virtuales ----------
.venv/
venv/
env/
ENV/

# ---------- Testing y cobertura ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
coverage.xml
*.cover

# ---------- Linting y type checking ----------
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ---------- Logs ----------
logs/
*.log

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Outputs de profiling ----------
*.prof
*.lprof
profile_results/
# normalized data (igual que raw/interim/output: nunca al repo)
data/normalized/*
!data/normalized/.gitkeep
